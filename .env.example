# Create a bot via @BotFather on Telegram, paste the token here
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID (send /start to @userinfobot to get it)
TELEGRAM_CHAT_ID=your-chat-id-here

# Web dashboard
WEB_PORT=3000
WEB_TOKEN=change-me-to-a-secret
# Bind address (default: 127.0.0.1 + Tailscale IP if detected)
# Set to 0.0.0.0 to listen on all interfaces
# WEB_BIND=127.0.0.1

# Remote workers (optional — only needed for multi-computer setup)
# Shared secret for worker authentication
# HIVE_WORKER_SECRET=change-me-to-a-secret
